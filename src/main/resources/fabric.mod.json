{
	"schemaVersion": 1,
	"id": "birchyhud",
	"version": "${version}",
	"name": "Birchy's Sprint Indicator",
	"description": "Sprint Indicator By BirchyBoii",
	"authors": [
		"BirchyBoii"
	],
	"contact": {
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/birchyhud/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"net.birchyboii.birchyhud.BirchysSprintIndicator"
		],
		"client": [
			"net.birchyboii.birchyhud.client.BirchysSprintIndicatorClient"
		],
		"modmenu": [
			"net.birchyboii.birchyhud.client.config.ModConfigScreen"
		]
	},
	"mixins": [
		"birchyhud.mixins.json",
		{
			"config": "birchyhud.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
